.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/
.nox/

# Type checker & linter caches
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ── Node.js & Dashboard Frontend ──────────────────────────────────────────────
node_modules/
dashboard/node_modules/
dashboard/dist/
dist/
out/

# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Logs & Runtime Artifacts ──────────────────────────────────────────────────
*.log
logs/
*.pid
*.seed
*.pid.lock
nohup.out
/tmp/

