# Google Gemini API Key (Recommended for live AI reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternatively, OpenAI API Key
# OPENAI_API_KEY=your_openai_api_key_here

# LLM Model (Defaults to gemini-1.5-flash for Gemini, or gpt-4o-mini for OpenAI)
LLM_MODEL=gemini-1.5-flash

# Gateway Settings
ENVIRONMENT=development
JWT_SECRET=urumi-super-secret-production-grade-jwt-signing-key-32charsmin
FERNET_KEY=k8s-mcp-gateway-production-fernet-key-32b=
